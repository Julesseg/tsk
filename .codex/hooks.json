{
  "description": "Repository lifecycle adapters for the shared .agents hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/dispatch.py\" codex session-start",
            "async": true,
            "timeout": 300,
            "statusMessage": "Preparing the repository"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/dispatch.py\" codex platform-guidance",
            "statusMessage": "Checking platform capabilities"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/dispatch.py\" codex validate-commit-msg",
            "timeout": 30,
            "statusMessage": "Checking commit message"
          }
        ]
      }
    ]
  }
}
